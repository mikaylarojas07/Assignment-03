<!--Form for adding a new assignment-->

<%- include partials/header.ejs %>

<div class="container mb-5 pb-5"> <!--Adds margins and padding to the bottom of the container div, Bootstrap styling-->
    <div class="row mb-4">
        <div class="offset-md-3 col-md-6 text-center">
            <!--Button to go back to the list page-->
            <a href="/assignments" class="btn btn-primary btn-back" role="button"> <i class="fas fa-arrow-left"></i> Back to Assignments</a>
        </div>
      </div>
            <div class="text-center">
            <h1>Add a new assignment</h1>
            </div>
            <form class="form" method="post"> <!--Creating the form that will be used to create lost item reports-->
                <div class="form-group"> <!--Using Bootstrap styling here as well -->
                    <label for="type">Assignment Type</label>
                    <input type="text" class="form-control" id="type"
                    placeholder="Test, assignment, quiz, essay"
                    name="type" required>
                </div>
                <div class="form-group">
                    <label for="courseCode">Course Code</label>
                    <input type="text" class="form-control" id="courseCode"
                    placeholder="eg. INFR3120"
                    name="courseCode" required>
                </div>
                <div class="form-group">
                    <label for="description">Assignment Description</label>
                    <textarea type="text" class="form-control" id="description"
                    placeholder="Enter the assignment description"
                    name="description" required></textarea>
                </div>
                <div class="form-group">
                    <label for="dueDate">Due Date</label>
                    <!--type="date" gives user a calendar picker and sends the value as yyyy-mm-dd-->
                    <input type="date" class="form-control" id="dueDate"
                    name="dueDate" required>
                </div>
                <div class="form-group">
                    <label for="priorityLevel">Priority Level</label>
                    <select class="form-control" id="priorityLevel" name="priorityLevel" required>
                        <!--using a dropdown menu to restrict the priority level value to three choices-->
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                    
                </div>
                <!--Submit and cancel buttons (Bootstrap)-->
                <button class="btn btn-primary" type="submit">
                    <!--Icons from fontawesome-free-->
                    <i class="fas fa-edit"></i> Add Assignment
                </button>
                <!--Cancel returns to the list without saving anything-->
                <a href="/assignments" class="btn btn-warning">
                    <i class="fas fa-undo"></i>Cancel
                </a>
            </form>
        </div>
    </div>
</div>

<%- include partials/footer.ejs %>